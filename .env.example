# ── SAF-MCP Skill Configuration ────────────────────────────────────
# Copy to .env and adjust values as needed.

# Server
HOST=127.0.0.1
PORT=3001          # MCP HTTP transport
# REST_PORT=3002   # OpenAPI REST server (src/openapi/serve.ts)

# Governance - Access Control
# Required whenever HOST is not loopback (the server refuses to start otherwise).
# SAF_MCP_REQUIRE_API_KEY=true
# SAF_MCP_API_KEYS=key-one-at-least-16-chars,key-two-at-least-16-chars
# SAF_MCP_REQUIRE_IP_ALLOWLIST=false
# SAF_MCP_IP_ALLOWLIST=127.0.0.1,::1,10.0.0.0/8   # addresses or CIDR ranges
# SAF_MCP_TRUST_PROXY=false                        # honor X-Forwarded-For only behind your own proxy

# Governance - Security Model (see README "Security Model")
# SAF_MCP_ALLOW_COMMAND_DISCOVERY=false   # REST/HTTP default off; true also requires API keys
# SAF_MCP_ALLOW_INSECURE_BIND=false       # non loopback HOST without API keys
# SAF_MCP_CORS_ORIGINS=                   # e.g. https://tools.example.com
# SAF_MCP_ALLOWED_HOSTS=                  # Host header values; loopback names by default on a loopback bind
# SAF_MCP_EXPOSED=false                   # true when a tunnel or proxy makes a loopback server reachable; requires API keys
# SAF_MCP_ALLOW_PRIVATE_URLS=             # URL discovery to private ranges when exposed

# Governance - Logging
# LOG_LEVEL=info              # debug | info | warn | error
# LOG_DIR=./logs
# LOG_TO_FILE=true
# LOG_TO_STDERR=true
