{
  "name": "safe-mcp-skill",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "safe-mcp-skill": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-data",
    "copy-data": "node -e \"const fs=require('fs');fs.cpSync('src/data','dist/data',{recursive:true});fs.cpSync('src/openapi/openapi.json','dist/openapi/openapi.json');\"",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:rest": "node dist/openapi/serve.js",
    "dev": "npx tsx src/index.ts",
    "dev:http": "npx tsx src/http.ts",
    "dev:rest": "npx tsx src/openapi/serve.ts",
    "test": "npx tsx src/tests/redteam.ts && npx tsx src/tests/catalog.ts && npx tsx src/tests/governance.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "ci": "npm run typecheck && npm run build && npm test",
    "test:governance": "npx tsx src/tests/governance.ts",
    "test:catalog": "npx tsx src/tests/catalog.ts",
    "sync:catalog": "tsx scripts/sync-catalog.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "yaml": "2.9.1"
  }
}
